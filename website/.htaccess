# Clean URLs on Hostinger: /privacy -> privacy.html, /terms -> terms.html
RewriteEngine On
RewriteRule ^delete-account/?$ /privacy.html#delete-account [R=301,NE,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
