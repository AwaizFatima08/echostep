{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true
    }
  },
  "hosting": {
    "public": "website",
    "ignore": [
      ".htaccess",
      "**/.*"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/delete-account",
        "destination": "/privacy#delete-account",
        "type": 301
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8085
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
