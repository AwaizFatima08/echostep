<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the local store out of Android's own cloud backup and
     device transfer. EchoSteps has its own opt-out-able, deletable backup
     (Firestore); a second, uncontrolled copy of children's data would not be. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
